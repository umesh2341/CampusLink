        about:"An evening of spoken-word poetry performances by student writers, open floor for walk-ins."}]
    },
    {
      id:"english-cafe", name:"SOA English Cafe", category:"literary",
      desc:"English communication & discussion club at ITER, SOA University.",
      coordinator:"CLUB HEAD",
      about:"Runs debate circles, book discussions, and spoken-English practice sessions in an informal cafe-style setting.",
      instagram:"@soaenglishcafe", instagramUrl:"https://www.instagram.com/soaenglishcafe", discord:"DISCORD",
      events:[{title:"Book Discussion Circle", date:"31 Aug", venue:"Cafeteria Deck",
        startDate:"Mon, 31 Aug, 2026", startTime:"5:00 pm", endDate:"Mon, 31 Aug, 2026", endTime:"6:30 pm",
        about:"Casual roundtable discussion on this month's pick — new members always welcome, no prep required."}]
    }
  ];

  var CATS = [
    {id:"all", label:"ALL"},
    {id:"technical", label:"TECHNICAL"},
    {id:"cultural", label:"CULTURAL"},
    {id:"literary", label:"LITERARY"}
  ];

  var activeCat = "all";
  var searchTerm = "";

  var pillsEl = document.getElementById('cl-pills');
  var listEl = document.getElementById('cl-list');
  var totalEl = document.getElementById('cl-total');
  var searchInput = document.getElementById('cl-search-input');
  var directoryOverlay = document.getElementById('cl-directory-overlay');
  var profileOverlay = document.getElementById('cl-profile-overlay');
  var profileBody = document.getElementById('cl-profile-body');

  function renderPills(){
    pillsEl.innerHTML = "";
    CATS.forEach(function(c){
      var btn = document.createElement('button');
      btn.className = 'cl-pill' + (activeCat === c.id ? ' cl-active' : '');
      btn.textContent = c.label;
      btn.onclick = function(){ activeCat = c.id; renderPills(); renderList(); };
      pillsEl.appendChild(btn);
    });
  }

  function filteredClubs(){
    return CLUBS.filter(function(c){
      var matchesCat = activeCat === 'all' || c.category === activeCat;
      var matchesSearch = c.name.toLowerCase().indexOf(searchTerm) !== -1;
      return matchesCat && matchesSearch;
    });
  }

  function renderList(){
    var clubs = filteredClubs();
    listEl.innerHTML = "";
    clubs.forEach(function(c){
      var card = document.createElement('div');
      card.className = 'cl-card';
      card.innerHTML =
        '<div class="cl-thumb"></div>' +
        '<div class="cl-card-body">' +
          '<div class="cl-card-title-row">' +
            '<span class="cl-card-title">' + c.name + '</span>' +
            '<span class="cl-tag">' + c.category.toUpperCase() + '</span>' +
          '</div>' +
          '<div class="cl-card-desc">' + c.desc + '</div>' +
        '</div>' +
        '<div class="cl-chev">›</div>';
      card.onclick = function(){ openProfile(c); };
      listEl.appendChild(card);
    });
    totalEl.textContent = 'TOTAL CLUBS: ' + CLUBS.length;
  }

  function openProfile(c){
    profileBody.innerHTML =
      '<div class="cl-profile-cover"><div class="cl-official">✓ OFFICIAL CLUB</div></div>' +
      '<div class="cl-profile-main">' +
        '<div class="cl-profile-avatar"></div>' +
        '<div class="cl-profile-title-row">' +
          '<span class="cl-profile-title">' + c.name + '</span>' +
          '<span class="cl-tag">' + c.category.toUpperCase() + '</span>' +
        '</div>' +
        '<div class="cl-coord">COORDINATOR: <b>' + c.coordinator + '</b></div>' +
        '<div class="cl-dotted"></div>' +
        '<div class="cl-section-label cl-bracket">ABOUT THE CLUB</div>' +
        '<div class="cl-about">' + c.about + '</div>' +
        '<div class="cl-section-label cl-bracket">OFFICIAL CHANNELS</div>' +
        '<div class="cl-channels">' +
          '<a class="cl-channel" href="' + (c.instagramUrl || '#') + '" target="_blank" rel="noopener">📷 ' + c.instagram + '</a>' +
          '<a class="cl-channel" href="#">💬 ' + c.discord + '</a>' +
        '</div>' +
        '<div class="cl-section-label cl-bracket">ACTIVE EVENTS (' + c.events.length + ')</div>' +
        c.events.map(function(ev, i){
          return '<div class="cl-event-card">' +
            '<div>' +
              '<div class="cl-event-title">' + ev.title + '</div>' +
              '<div class="cl-event-meta">📅 ' + ev.date + ' &nbsp;•&nbsp; ' + ev.venue + '</div>' +
            '</div>' +
            '<button class="cl-viewpass" data-club="' + c.id + '" data-idx="' + i + '">VIEW PASS</button>' +
          '</div>';
        }).join('') +
      '</div>';
    directoryOverlay.classList.add('cl-hidden');
    profileOverlay.classList.remove('cl-hidden');

    Array.prototype.forEach.call(profileBody.querySelectorAll('.cl-viewpass'), function(btn){
      btn.onclick = function(){
        var club = CLUBS.filter(function(x){ return x.id === btn.getAttribute('data-club'); })[0];
        var ev = club.events[parseInt(btn.getAttribute('data-idx'), 10)];
        openPass(club, ev);
      };
    });
  }

  function openPass(club, ev){
    var passBody = document.getElementById('cl-pass-body');
    passBody.innerHTML =
      '<div class="cl-pass-title">' + ev.title + '</div>' +
      '<div class="cl-pass-org">👥 ORGANIZER: <b>' + club.name + '</b></div>' +
      '<div class="cl-pass-card">' +
        '<div class="cl-pass-row">' +
          '<div class="cl-pass-col">' +
            '<div class="cl-pass-label">STARTS</div>' +
            '<div class="cl-pass-value">📅 ' + ev.startDate + '</div>' +
            '<div class="cl-pass-time">🕐 ' + ev.startTime + '</div>' +
          '</div>' +
          '<div class="cl-pass-col">' +
            '<div class="cl-pass-label">ENDS</div>' +
            '<div class="cl-pass-value">📅 ' + ev.endDate + '</div>' +
            '<div class="cl-pass-time">🕐 ' + ev.endTime + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="cl-pass-divider"></div>' +
        '<div class="cl-pass-label">VENUE</div>' +
        '<div class="cl-pass-venue-row">📍 ' + ev.venue + '</div>' +
      '</div>' +
      '<div class="cl-section-label cl-bracket">ABOUT</div>' +
      '<div class="cl-about">' + ev.about + '</div>';
    profileOverlay.classList.add('cl-hidden');
    document.getElementById('cl-pass-overlay').classList.remove('cl-hidden');
  }

  function closePass(){
    document.getElementById('cl-pass-overlay').classList.add('cl-hidden');
    profileOverlay.classList.remove('cl-hidden');
  }
  document.getElementById('cl-pass-close').onclick = closePass;

  document.getElementById('cl-profile-close').onclick = function(){
    profileOverlay.classList.add('cl-hidden');
    directoryOverlay.classList.remove('cl-hidden');
  };
  document.getElementById('cl-profile-close-2').onclick = function(){
    profileOverlay.classList.add('cl-hidden');
    directoryOverlay.classList.remove('cl-hidden');
  };

  searchInput.addEventListener('input', function(e){
    searchTerm = e.target.value.toLowerCase();
    renderList();
  });

  renderPills();
  renderList();
})();
</script>
