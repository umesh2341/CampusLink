<style>
  :root{
    --cl-ink:#1a1a1a;
    --cl-paper:#efe9dd;
    --cl-paper-dim:#e2dbca;
    --cl-orange:#d9722c;
    --cl-orange-dark:#b85e21;
    --cl-line:#1a1a1a;
    --cl-muted:#6b6459;
    --cl-white:#faf7f0;
    --cl-green:#1e5c2f;
  }
  #cl-root{
    font-family:'Courier New', ui-monospace, 'JetBrains Mono', monospace;
    color:var(--cl-ink);
    background:var(--cl-paper-dim);
    border:2px solid var(--cl-line);
    max-width:640px;
    margin:0 auto;
    position:relative;
    min-height:600px;
    overflow:hidden;
  }
  #cl-root *{ box-sizing:border-box; }
  .cl-hidden{ display:none !important; }

  /* ---- shared bracket label ---- */
  .cl-bracket{ letter-spacing:.5px; }
  .cl-bracket::before{ content:"[ "; }
  .cl-bracket::after{ content:" ]"; }

  /* ---- top strip ---- */
  .cl-topbar{
    display:flex; align-items:center; justify-content:space-between;
    background:var(--cl-ink); color:var(--cl-white);
    padding:12px 16px;
  }
  .cl-brand{ display:flex; align-items:center; gap:10px; }
  .cl-logo{
    width:34px; height:34px; background:var(--cl-white); color:var(--cl-ink);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:13px; letter-spacing:.5px; border:2px solid var(--cl-white);
  }
  .cl-brand-text{ line-height:1.15; }
  .cl-brand-title{ font-weight:700; letter-spacing:1px; font-size:14px; }
  .cl-brand-sub{ font-size:9px; color:#b8b2a4; letter-spacing:1px; }
  .cl-top-actions{ display:flex; gap:8px; align-items:center; }
  .cl-btn{
    font-family:inherit; font-size:10px; font-weight:700; letter-spacing:.5px;
    padding:7px 10px; border:1px solid #555; background:transparent; color:var(--cl-white);
    display:flex; align-items:center; gap:5px; cursor:pointer; text-transform:uppercase;
  }
  .cl-btn.cl-primary{ background:var(--cl-orange); border-color:var(--cl-orange); color:var(--cl-ink); }

  .cl-alert{
    background:var(--cl-orange); color:var(--cl-ink);
    display:flex; align-items:center; gap:8px; padding:9px 12px; font-size:11px; font-weight:700;
  }
  .cl-alert-badge{ margin-left:auto; background:var(--cl-ink); color:var(--cl-white); padding:3px 7px; font-size:9px; }

  /* ---- backdrop scene (fake map bg) ---- */
  .cl-scene{ height:420px; background:var(--cl-paper); position:relative; }

  /* ---- bottom nav ---- */
  .cl-bottomnav{
    display:flex; border-top:2px solid var(--cl-line); background:var(--cl-paper-dim);
  }
  .cl-navitem{
    flex:1; display:flex; flex-direction:column; align-items:center; gap:4px;
    padding:10px 4px; font-size:9px; letter-spacing:.5px; color:var(--cl-ink); position:relative;
  }
  .cl-navitem svg{ width:18px; height:18px; }
  .cl-navbadge{
    position:absolute; top:2px; right:22%; background:var(--cl-orange); color:var(--cl-ink);
    font-size:8px; font-weight:700; padding:1px 4px; border-radius:8px;
  }

  /* ---- modal overlay ---- */
  .cl-overlay{
    position:absolute; inset:0; background:rgba(20,18,14,.55);
    display:flex; align-items:center; justify-content:center; padding:14px; z-index:10;
  }
  .cl-modal{
    background:var(--cl-paper); border:2px solid var(--cl-line);
    width:100%; max-height:520px; display:flex; flex-direction:column; overflow:hidden;
  }
  .cl-modal-head{
    background:var(--cl-ink); color:var(--cl-white);
    display:flex; align-items:center; justify-content:space-between;
    padding:11px 14px; font-size:12px; font-weight:700; letter-spacing:.5px;
  }
  .cl-modal-head .cl-x{ cursor:pointer; background:none; border:none; color:var(--cl-white); font-size:15px; font-family:inherit; }
  .cl-modal-head-left{ display:flex; align-items:center; gap:8px; }

  /* ---- directory body ---- */
  .cl-search{ padding:12px; border-bottom:1px solid #cfc7b4; }
  .cl-search input{
    width:100%; font-family:inherit; font-size:11px; padding:9px 10px;
    border:1px solid var(--cl-line); background:var(--cl-white); color:var(--cl-ink);
    letter-spacing:.5px; text-transform:uppercase;
  }
  .cl-search input::placeholder{ color:#9a9384; text-transform:uppercase; }

  .cl-pills{ display:flex; gap:6px; padding:0 12px 12px; flex-wrap:wrap; }
  .cl-pill{
    font-family:inherit; font-size:10px; font-weight:700; letter-spacing:.5px;
    padding:6px 12px; border:1px solid var(--cl-line); background:var(--cl-white);
    color:var(--cl-ink); cursor:pointer; text-transform:uppercase;
  }
  .cl-pill.cl-active{ background:var(--cl-orange); border-color:var(--cl-orange); }

  .cl-list{ overflow-y:auto; padding:0 12px; flex:1; }
  .cl-card{
    display:flex; align-items:center; gap:12px; border:1px solid var(--cl-line);
    background:var(--cl-white); padding:10px; margin-bottom:10px; cursor:pointer;
  }
  .cl-card:hover{ background:var(--cl-paper); }
  .cl-thumb{
    width:44px; height:44px; flex-shrink:0; background:repeating-linear-gradient(45deg,#0c1f10,#0c1f10 2px,#123018 2px,#123018 4px);
    border:1px solid var(--cl-line);
  }
  .cl-card-body{ flex:1; min-width:0; }
  .cl-card-title-row{ display:flex; align-items:center; gap:7px; margin-bottom:2px; }
  .cl-card-title{ font-size:12.5px; font-weight:700; letter-spacing:.3px; }
  .cl-tag{ font-size:8.5px; font-weight:700; padding:2px 6px; border:1px solid var(--cl-line); background:var(--cl-paper-dim); letter-spacing:.5px; }
  .cl-card-desc{ font-size:10.5px; color:var(--cl-muted); line-height:1.3; }
  .cl-chev{ color:var(--cl-muted); font-size:14px; flex-shrink:0; }

  .cl-modal-foot{
    display:flex; align-items:center; justify-content:space-between;
    padding:11px 14px; border-top:1px solid #cfc7b4; font-size:10.5px; font-weight:700;
  }
  .cl-done{
    font-family:inherit; font-size:10.5px; font-weight:700; padding:8px 16px;
    border:1px solid var(--cl-line); background:var(--cl-white); cursor:pointer; letter-spacing:.5px;
  }

  /* ---- profile modal ---- */
  .cl-profile-scroll{ overflow-y:auto; flex:1; }
  .cl-profile-cover{
    height:120px; background:repeating-linear-gradient(45deg,#0c1f10,#0c1f10 2px,#123018 2px,#123018 4px);
    position:relative; border-bottom:1px solid var(--cl-line);
  }
  .cl-official{
    position:absolute; top:8px; right:8px; background:var(--cl-white); border:1px solid var(--cl-line);
    font-size:8.5px; font-weight:700; padding:3px 7px; display:flex; align-items:center; gap:4px; color:var(--cl-green);
  }
  .cl-profile-main{ padding:14px; }
  .cl-profile-avatar{
    width:52px; height:52px; margin-top:-40px; margin-bottom:10px;
    background:repeating-linear-gradient(45deg,#0c1f10,#0c1f10 2px,#123018 2px,#123018 4px);
    border:2px solid var(--cl-paper);
  }
  .cl-profile-title-row{ display:flex; align-items:center; gap:8px; margin-bottom:4px; flex-wrap:wrap; }
  .cl-profile-title{ font-size:17px; font-weight:700; letter-spacing:.3px; }
  .cl-coord{ font-size:10.5px; color:var(--cl-muted); margin-bottom:12px; }
  .cl-coord b{ color:var(--cl-ink); }
  .cl-dotted{ border-top:1px dashed #b8b2a4; margin:10px 0 14px; }

  .cl-section-label{ font-size:10.5px; font-weight:700; letter-spacing:.5px; margin-bottom:8px; }
  .cl-about{
    font-size:11px; line-height:1.55; background:var(--cl-paper-dim); border:1px solid #cfc7b4;
    padding:11px; margin-bottom:16px;
  }
  .cl-channels{ display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; }
  .cl-channel{
    flex:1; min-width:130px; display:flex; align-items:center; justify-content:center; gap:6px;
    border:1px solid var(--cl-line); background:var(--cl-paper-dim);
    padding:9px; font-size:11px; font-weight:700; text-decoration:none; color:var(--cl-ink);
  }
  .cl-channel svg{ width:14px; height:14px; }
  .cl-event-card{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    border:1px solid var(--cl-line); background:var(--cl-white); padding:11px; margin-bottom:8px;
  }
  .cl-event-title{ font-size:12px; font-weight:700; margin-bottom:3px; }
  .cl-event-meta{ font-size:10px; color:var(--cl-muted); display:flex; align-items:center; gap:5px; }
  .cl-viewpass{
    font-family:inherit; font-size:9.5px; font-weight:700; padding:7px 10px; letter-spacing:.5px;
    background:var(--cl-orange); border:1px solid var(--cl-orange); color:var(--cl-ink); cursor:pointer; white-space:nowrap;
  }
  .cl-profile-foot{
    display:flex; align-items:center; justify-content:space-between; padding:11px 14px;
    border-top:1px solid #cfc7b4; font-size:9.5px; color:var(--cl-muted); font-weight:700; letter-spacing:.5px;
  }

  /* ---- event pass modal ---- */
  .cl-pass-body{ padding:18px 16px; overflow-y:auto; flex:1; }
  .cl-pass-title{ font-size:19px; font-weight:700; letter-spacing:.3px; margin-bottom:10px; }
  .cl-pass-org{ display:flex; align-items:center; gap:7px; font-size:11px; color:var(--cl-muted); margin-bottom:12px; }
  .cl-pass-org b{ color:var(--cl-ink); }
  .cl-pass-card{
    border:1px solid var(--cl-line); background:var(--cl-paper-dim); padding:14px; margin-bottom:16px;
  }
  .cl-pass-row{ display:flex; gap:18px; }
  .cl-pass-col{ flex:1; }
  .cl-pass-label{ font-size:9.5px; font-weight:700; color:var(--cl-muted); letter-spacing:.5px; margin-bottom:6px; }
  .cl-pass-label::before{ content:"— "; }
  .cl-pass-value{ font-size:12px; font-weight:700; display:flex; align-items:center; gap:6px; margin-bottom:3px; }
  .cl-pass-time{ font-size:11px; display:flex; align-items:center; gap:6px; color:var(--cl-ink); }
  .cl-pass-divider{ border-top:1px dashed #b8b2a4; margin:12px 0; }
  .cl-pass-venue-row{ display:flex; align-items:center; gap:6px; font-size:12px; font-weight:700; }
</style>

