      desc:"Literature & writing society at ITER, SOA University.",
      coordinator:"EDITOR-IN-CHIEF",
      about:"Hosts poetry slams, creative-writing workshops, and publishes the campus literary journal each semester.",
      instagram:"@soaliterary_club", instagramUrl:"https://www.instagram.com/soaliterary_club", discord:"DISCORD",
      events:[{title:"Poetry Slam Night", date:"30 Aug", venue:"Library Lawn",
